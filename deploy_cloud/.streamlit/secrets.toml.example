# secrets.toml.example — copy to secrets.toml (local dev) or set in
# Streamlit Cloud → Settings → Secrets (production).
#
# secrets.toml must NEVER be committed to the repo (token = full access).
#
# How to set on Streamlit Cloud:
#   https://share.streamlit.io/ → your app → Settings → Secrets → paste:
#     DATABRICKS_HOST = "https://dbc-9e268203-7090.cloud.databricks.com"
#     DATABRICKS_TOKEN = "dapi..."
#
# If these secrets are absent, the app automatically falls back to the
# local .pkl models (sidebar shows "🟡 Inference : modele local (.pkl)").
# When present, predictions come from the live Databricks endpoint
# (sidebar shows "🟢 Inference : Databricks Model Serving (live)").

DATABRICKS_HOST = "https://dbc-9e268203-7090.cloud.databricks.com"
DATABRICKS_TOKEN = "dapi-your-token-here"
